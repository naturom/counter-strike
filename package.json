{
  "name": "sirocco-desert-fps",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx apps/server/src/index.ts",
    "build": "npm run build -w apps/web && tsup",
    "start": "NODE_ENV=production node apps/server/dist/index.cjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "tsx scripts/live-smoke.ts",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "portraits": "node scripts/generate-avatar-thumbnails.cjs"
  },
  "overrides": {
    "nanoid": "^3.3.20"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "tsup": "8.5.0",
    "@types/node": "22.18.6",
    "@types/three": "^0.183.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.56.1",
    "@colyseus/sdk": "0.18.5"
  }
}
